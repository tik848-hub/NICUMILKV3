<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#9A3412">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="โภชนาการ NICU">
  <link rel="manifest" href="../manifest-nutrition.json">
  <link rel="icon" href="../icons/icon-nutrition-192.png">
  <link rel="apple-touch-icon" href="../icons/icon-nutrition-192.png">
  <title>โภชนาการ NICU</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
  <link rel="stylesheet" href="../shared/style.css">
  <style>:root{--header-bg:#9A3412}</style>
</head>
<body>
<div id="app">

  <div id="offline-bar" class="offline-bar"><i class="ti ti-wifi-off"></i> ออฟไลน์ — ข้อมูลจาก cache</div>

  <header class="header">
    <i class="ti ti-building-store hdr-icon" aria-hidden="true"></i>
    <div class="hdr-titles">
      <div class="hdr-title">โภชนาการ NICU</div>
      <div class="hdr-sub">รามาธิบดีจักรีนฤบดินทร์</div>
    </div>
    <div class="hdr-right">
      <span id="hdr-date" class="hdr-badge"></span>
      <span class="sync-dot" title="sync"></span>
    </div>
  </header>

  <main class="main-content" role="main">

    <!-- ═══ DASHBOARD ═══ -->
    <section id="pg-dashboard" class="page" aria-label="ภาพรวม">
      <div class="card">
        <div class="card-title"><i class="ti ti-chart-bar" aria-hidden="true"></i> ภาพรวมวันนี้</div>
        <div id="d-flow" style="display:flex;align-items:center;justify-content:center;gap:0;padding:4px 0"></div>
      </div>
      <div class="metrics-2">
        <div class="metric t-teal"><div class="m-val teal" id="d-pts">—</div><div class="m-lbl">ผู้ป่วย NICU</div></div>
        <div class="metric t-green"><div class="m-val green" id="d-appr">—</div><div class="m-lbl">Approved</div></div>
      </div>
      <div class="metrics-2">
        <div class="metric t-amber"><div class="m-val amber" id="d-total">—</div><div class="m-lbl">คำสั่งทั้งหมด</div></div>
        <div class="metric" style="border-top:3px solid var(--orange-500)"><div class="m-val" style="color:var(--orange-800)" id="d-printed">—</div><div class="m-lbl">พิมพ์บัตรแล้ว</div></div>
      </div>
      <div id="d-alerts"></div>
      <div class="sec-label">คำสั่งนม Approved วันนี้</div>
      <div class="card" style="padding:8px 12px"><div id="d-order-list"></div></div>
    </section>

    <!-- ═══ PRODUCE ═══ -->
    <section id="pg-produce" class="page" aria-label="ผลิตนม">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
        <div class="sec-label" style="margin:0">คำสั่ง Approved (<span id="prod-count">—</span>)</div>
        <button class="btn btn-sm" onclick="printCards()" style="display:none" id="print-all-btn">
          <i class="ti ti-printer" aria-hidden="true"></i> Print ทั้งหมด
        </button>
      </div>
      <div id="prod-list"></div>
      <div id="prod-cards-section" style="display:none">
        <div style="display:flex;align-items:center;justify-content:space-between;margin:10px 0 8px">
          <div class="sec-label" style="margin:0">บัตรนม</div>
          <button class="btn btn-sm" style="background:var(--orange-500);border-color:var(--orange-800);color:#fff" onclick="printCards()">
            <i class="ti ti-printer" aria-hidden="true"></i> Print A4
          </button>
        </div>
        <div id="prod-card-grid" class="milk-card-grid"></div>
      </div>
    </section>

  </main>

  <nav class="bottom-nav" aria-label="เมนูหลัก">
    <button class="nav-item active" id="nv-dashboard" onclick="showPage('dashboard')" aria-label="ภาพรวม">
      <i class="ti ti-layout-dashboard" aria-hidden="true"></i><span>ภาพรวม</span>
    </button>
    <button class="nav-item" id="nv-produce" onclick="showPage('produce')" aria-label="ผลิตนม">
      <i class="ti ti-printer" aria-hidden="true"></i><span>ผลิตนม</span>
    </button>
  </nav>
</div>

<div id="toast" class="toast" role="alert" aria-live="polite"></div>

<script src="../shared/db.js"></script>
<script src="app.js"></script>
</body>
</html>
